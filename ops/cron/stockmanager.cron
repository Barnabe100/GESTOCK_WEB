# Tâches planifiées de StockManager Web (exemple : /etc/cron.d/stockmanager). Heures en UTC.
# Chaque commande lit son environnement depuis /etc/stockmanager/*.env (droits 0600, hors dépôt).
# Adapter « docker compose … exec/run » si l'application tourne en conteneurs
# (docs/DEPLOIEMENT.md §5). Toute sortie non vide est envoyée par cron à MAILTO.
MAILTO=exploitation@example.invalid
SHELL=/bin/bash

# Sauvegardes (R11-0) : planification dédiée — ops/systemd/ (recommandé) ou
# ops/cron/stockmanager-backup.cron ; procédure docs/exploitation/SAUVEGARDE_RESTAURATION.md §5.
# Rappels d'échéance des abonnements (idempotent) et conservation (30 jours).
5 3 * * *   stockmgr  set -a; . /etc/stockmanager/console.env; set +a; stockmanager notifications run
25 3 * * *  stockmgr  set -a; . /etc/stockmanager/purge.env; set +a; stockmanager notifications purge
# Supervision générale toutes les 5 minutes (API, signature ; sauvegardes via SM_BACKUP_HEALTH_CMD).
*/5 * * * * monitor   set -a; . /etc/stockmanager/monitor.env; set +a; /opt/stockmanager/monitoring/sm-healthcheck.sh >/dev/null || echo "StockManager : supervision en anomalie"
