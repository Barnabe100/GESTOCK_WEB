# Sauvegardes StockManager (R11-0, R11) — ALTERNATIVE aux unités systemd (ops/systemd/,
# recommandées : journal, durée maximale).
# Les ÉCHÉANCES (sauvegardes physiques et logiques, vérification, test de restauration) ne sont
# plus fixées ici : elles viennent des paramètres de la console TechNova, exécutés par l'agent
# (chaque minute, fuseau propre à chaque paramètre : l'hôte n'a plus besoin d'être en UTC pour
# elles).
# Installation : copie dans /etc/cron.d/stockmanager-backup (root:root, 0644).
# La copie externe ci-dessous suit le fuseau de l'hôte (cron).
# Les tâches ne se chevauchent pas dangereusement : flock -n empêche deux exécutions de la même
# tâche, et les opérations lourdes partagent un verrou dans le conteneur (attente puis échec).
SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
MAILTO=root

# Chaque minute : agent des sauvegardes (planification et demandes de la console, ADR-0058).
* * * * *  root  flock -n /run/lock/sm-backup-agent.lock /opt/stockmanager/ops/backup/sm-backup-host.sh agent >/dev/null
# Toutes les 5 minutes : supervision (sortie seulement en anomalie).
*/5 * * * * root  flock -n /run/lock/sm-backup-health.lock /opt/stockmanager/ops/backup/sm-backup-host.sh health >/dev/null || echo "StockManager : supervision des sauvegardes en anomalie"
# Chaque jour 04:15 : copie externe (enregistre « non configurée » tant que TechNova ne l'a pas configurée).
15 4 * * *  root  flock -n /run/lock/sm-backup-offsite.lock /opt/stockmanager/ops/backup/sm-backup-host.sh offsite >/dev/null
