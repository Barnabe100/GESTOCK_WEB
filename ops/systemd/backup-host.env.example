# /etc/stockmanager/backup-host.env (droits 0600, root) — lanceur des tâches de sauvegarde.
# Répertoire contenant docker-compose.yml (le dépôt sur l'hôte) :
SM_COMPOSE_DIR=/opt/stockmanager
# Fichiers Compose (le docker-compose.yml LOCAL, port inchangé, puis le complément) :
SM_COMPOSE_FILES=-f docker-compose.yml -f docker-compose.backup.yml
# Répertoire des sauvegardes sur l'hôte (même valeur que dans .env) :
SM_BACKUP_HOST_DIR=/srv/stockmanager-backups
# Facultatif : commande appelée en cas d'échec (niveau, tâche), ex. envoi de courriel.
# SM_ALERT_COMMAND=/usr/local/bin/stockmanager-alert
