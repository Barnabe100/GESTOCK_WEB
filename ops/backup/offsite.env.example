# Copie externe des sauvegardes (Restic + stockage S3-compatible) — EXEMPLE, à copier HORS du
# dépôt (ex. /etc/stockmanager/offsite.env, droits 0600, propriétaire root). Jamais commité.
# Tant que ces valeurs ne sont pas renseignées, la copie externe est « non configurée ».
#
# Dépôt Restic (fournisseur à choisir par TechNova ; compartiment avec verrouillage d'objets) :
# RESTIC_REPOSITORY=s3:https://<point-d-acces-s3>/<compartiment>/stockmanager
# Clé du dépôt : FICHIER monté en lecture seule (docker-compose.backup.yml, SM_OFFSITE_KEY_FILE).
RESTIC_PASSWORD_FILE=/run/secrets/restic-password
# Identifiants d'accès au compartiment (droits limités : écriture et lecture, pas de suppression
# si le verrouillage d'objets est utilisé) :
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=
# Rétention dans le dépôt externe (≥ rétention locale de 30 jours) :
SM_OFFSITE_KEEP_WITHIN=35d
# Élagage (suppression des données expirées) : 0 avec un verrouillage en mode conformité.
SM_OFFSITE_PRUNE=0
# Part des données relue à chaque vérification de la copie :
SM_OFFSITE_CHECK_SUBSET=5%
