SM_ENVIRONMENT=development
SM_DEBUG=true
# Rôle applicatif (sans BYPASSRLS) — API et provisioning
SM_DATABASE_URL=postgresql+psycopg://stockmanager_app:stockmanager_app@localhost:5432/stockmanager
# Rôle propriétaire — migrations et catalogue
SM_MIGRATION_DATABASE_URL=postgresql+psycopg://stockmanager:stockmanager@localhost:5432/stockmanager
SM_DB_APP_ROLE=stockmanager_app
# Obligatoire en production (≥ 32 caractères)
SM_JWT_SECRET=change-me-change-me-change-me-change-me
# false uniquement en développement HTTP
SM_REFRESH_COOKIE_SECURE=false
SM_CORS_ORIGINS=["http://localhost:5173"]
# Commandes par QR Code (R7, ADR-0052) — adresse PUBLIQUE de l'interface intégrée aux QR Codes.
# Absente en développement : http://localhost:5173. Hors développement : obligatoire, https,
# domaine présent dans SM_PUBLIC_ALLOWED_HOSTS. Test sur un téléphone du réseau local :
#   SM_PUBLIC_APP_URL=http://192.168.1.20:5173  et  SM_PUBLIC_ALLOWED_HOSTS=["192.168.1.20"]
# SM_PUBLIC_APP_URL=
# SM_PUBLIC_ALLOWED_HOSTS=[]
# Proxies de confiance (adresses ou CIDR) dont X-Forwarded-For est lu ; vide = aucun.
# SM_TRUSTED_PROXIES=[]
# Clé des empreintes HMAC des adresses IP (limitation de fréquence) : obligatoire en production
# (≥ 32 caractères), jamais commitée.
# SM_RATE_LIMIT_HMAC_KEY=
