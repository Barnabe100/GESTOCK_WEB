# Image backend de PRODUCTION — API des entreprises, console TechNova et CLI (même image,
# commande différente). Aucun secret ni domaine dans l'image : tout vient de l'environnement
# (docs/DEPLOIEMENT.md §2). Utilisateur non root ; dépendances figées (uv.lock), sans outils de
# développement. La clé privée de signature n'est JAMAIS ici (Signing Service déployé à part).
FROM python:3.11-slim AS build
ENV UV_PROJECT_ENVIRONMENT=/opt/venv UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
RUN pip install --no-cache-dir "uv>=0.8,<0.9"
WORKDIR /app
COPY backend/pyproject.toml backend/uv.lock backend/README.md ./
RUN uv sync --frozen --no-dev --no-install-project
COPY backend/ ./
RUN uv sync --frozen --no-dev

FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PATH="/opt/venv/bin:$PATH" \
    SM_ENVIRONMENT=production
RUN useradd --system --uid 10001 --home-dir /app --shell /usr/sbin/nologin stockmanager
COPY --from=build /opt/venv /opt/venv
COPY --from=build --chown=root:root /app /app
WORKDIR /app
USER 10001
EXPOSE 8000
# Derrière le mandataire TLS : en-têtes de transfert acceptés des seuls mandataires déclarés
# (FORWARDED_ALLOW_IPS) ; nombre de processus : WEB_CONCURRENCY.
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--no-server-header"]
